## Instance specific configurations.
## Specified with bash variable assignment syntax.
## These values supplement or override the values in global.env and can
##  be overridden further using Makefile options when creating instances.

## Default Tomcat for this template; override to upgrade to newer patch version
CATALINA_HOME=/usr/local/apache-tomcat-11.0.2

## Required instance-specific values
HTTP_PORT=9N80
AJP13_PORT=9N09
JMX_PORT=9N05
TOMCAT_USER=tomcat_X


## Optional: set to override defaults in global.env or the Makefile options
#JAVA_HOME
#JSVC_EXE
#CATALINA_OPTS
